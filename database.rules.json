{
  "rules": {
    "queue": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || (data.child('status').val() === 'waiting' && newData.child('status').val() === 'matched' && newData.child('opponentUid').val() === auth.uid))"
      }
    },
    "onlineRooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (newData.child('players').child(auth.uid).exists() || data.child('players').child(auth.uid).exists())",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
