{
  "rules": {
    "onlineRooms": {
      "$roomId": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        ".write": "auth != null && (data.child('players').child(auth.uid).exists() || newData.child('players').child(auth.uid).exists())",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
